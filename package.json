{
  "name": "dsh-plugin-chat",
  "version": "0.1.0",
  "type": "module",
  "description": "Chat mode for DeepSeek Harness: a switch in the sidebar chrome row opens a conversation-only session with no directory picking, no coding tools, web search, and a configurable system prompt.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "chat"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "icon": "icon.svg",
  "license": "MIT",
  "author": "wunengbiao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wunengbiao/dsh-plugin-chat.git"
  },
  "homepage": "https://github.com/wunengbiao/dsh-plugin-chat#readme",
  "bugs": {
    "url": "https://github.com/wunengbiao/dsh-plugin-chat/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "check:json": "node -e \"for (const f of ['package.json','locale/en.json','locale/zh.json']) JSON.parse(require('fs').readFileSync(f,'utf8')); console.log('manifest and locales ok')\""
  }
}
